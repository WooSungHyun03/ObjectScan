# Example user unit. Replace checkout and EnvironmentFile paths for this host.
[Unit]
Description=ObjectScan outbound single-slot worker (user service)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10
[Service]
Type=simple
WorkingDirectory=%h/Desktop/ObjectScan/ObjectScan-v2
EnvironmentFile=%h/.config/objectscan/worker.env
ExecStart=%h/Desktop/ObjectScan/ObjectScan-v2/gpu-worker/.venv/bin/objectscan-worker
Restart=on-failure
RestartSec=15
KillMode=mixed
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=default.target
